{
  "CheckpointLoaderSimple": {
    "input": {
      "required": {
        "ckpt_name": [
          ["flux2-klein-4b.safetensors", "z-image-turbo.safetensors"],
          { "tooltip": "The name of the checkpoint (model) to load." }
        ]
      }
    },
    "input_order": { "required": ["ckpt_name"] },
    "output": ["MODEL", "CLIP", "VAE"],
    "output_is_list": [false, false, false],
    "output_name": ["MODEL", "CLIP", "VAE"],
    "name": "CheckpointLoaderSimple",
    "display_name": "Load Checkpoint",
    "description": "Loads a diffusion model checkpoint, its CLIP and its VAE.",
    "python_module": "nodes",
    "category": "loaders",
    "output_node": false
  },
  "CLIPTextEncode": {
    "input": {
      "required": {
        "text": ["STRING", { "multiline": true, "dynamicPrompts": true }],
        "clip": ["CLIP", { "tooltip": "The CLIP model used for encoding the text." }]
      }
    },
    "input_order": { "required": ["text", "clip"] },
    "output": ["CONDITIONING"],
    "output_is_list": [false],
    "output_name": ["CONDITIONING"],
    "name": "CLIPTextEncode",
    "display_name": "CLIP Text Encode (Prompt)",
    "description": "Encodes a text prompt into an embedding the sampler can steer with.",
    "python_module": "nodes",
    "category": "conditioning",
    "output_node": false
  },
  "EmptyLatentImage": {
    "input": {
      "required": {
        "width": ["INT", { "default": 512, "min": 16, "max": 16384, "step": 8 }],
        "height": ["INT", { "default": 512, "min": 16, "max": 16384, "step": 8 }],
        "batch_size": ["INT", { "default": 1, "min": 1, "max": 4096 }]
      }
    },
    "input_order": { "required": ["width", "height", "batch_size"] },
    "output": ["LATENT"],
    "output_is_list": [false],
    "output_name": ["LATENT"],
    "name": "EmptyLatentImage",
    "display_name": "Empty Latent Image",
    "description": "Creates a blank latent image for text-to-image sampling.",
    "python_module": "nodes",
    "category": "latent",
    "output_node": false
  },
  "KSampler": {
    "input": {
      "required": {
        "model": ["MODEL", { "tooltip": "The model used for denoising." }],
        "seed": [
          "INT",
          { "default": 0, "min": 0, "max": 18446744073709551615, "control_after_generate": true }
        ],
        "steps": ["INT", { "default": 20, "min": 1, "max": 10000 }],
        "cfg": ["FLOAT", { "default": 8.0, "min": 0.0, "max": 100.0, "step": 0.1 }],
        "sampler_name": [["euler", "euler_ancestral", "dpmpp_2m", "dpmpp_2m_sde"], {}],
        "scheduler": ["COMBO", { "options": ["normal", "karras", "simple", "beta"] }],
        "positive": ["CONDITIONING", {}],
        "negative": ["CONDITIONING", {}],
        "latent_image": ["LATENT", {}],
        "denoise": ["FLOAT", { "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01 }]
      }
    },
    "input_order": {
      "required": [
        "model",
        "seed",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "positive",
        "negative",
        "latent_image",
        "denoise"
      ]
    },
    "output": ["LATENT"],
    "output_is_list": [false],
    "output_name": ["LATENT"],
    "name": "KSampler",
    "display_name": "KSampler",
    "description": "Denoises a latent image with the given model and conditioning.",
    "python_module": "nodes",
    "category": "sampling",
    "output_node": false
  },
  "VAEDecode": {
    "input": {
      "required": {
        "samples": ["LATENT", {}],
        "vae": ["VAE", {}]
      }
    },
    "input_order": { "required": ["samples", "vae"] },
    "output": ["IMAGE"],
    "output_is_list": [false],
    "output_name": ["IMAGE"],
    "name": "VAEDecode",
    "display_name": "VAE Decode",
    "description": "Decodes latent images back into pixel space.",
    "python_module": "nodes",
    "category": "latent",
    "output_node": false
  },
  "SaveImage": {
    "input": {
      "required": {
        "images": ["IMAGE", {}],
        "filename_prefix": ["STRING", { "default": "ComfyUI" }]
      },
      "optional": {
        "quality": ["INT", { "default": 90, "min": 1, "max": 100 }]
      }
    },
    "input_order": { "required": ["images", "filename_prefix"], "optional": ["quality"] },
    "output": [],
    "output_is_list": [],
    "output_name": [],
    "name": "SaveImage",
    "display_name": "Save Image",
    "description": "Writes the images to the server's output directory.",
    "python_module": "nodes",
    "category": "image",
    "output_node": true
  },
  "LoadImage": {
    "input": {
      "required": {
        "image": [["example.png", "idol-front.png"], { "image_upload": true }]
      }
    },
    "input_order": { "required": ["image"] },
    "output": ["IMAGE", "MASK"],
    "output_is_list": [false, false],
    "output_name": ["IMAGE", "MASK"],
    "name": "LoadImage",
    "display_name": "Load Image",
    "description": "Reads an image from the server's input directory.",
    "python_module": "nodes",
    "category": "image",
    "output_node": false
  },
  "SaveGLB": {
    "input": {
      "required": {
        "mesh": ["MESH", {}],
        "filename_prefix": ["STRING", { "default": "3d/ComfyUI" }]
      }
    },
    "input_order": { "required": ["mesh", "filename_prefix"] },
    "output": [],
    "output_is_list": [],
    "output_name": [],
    "name": "SaveGLB",
    "display_name": "Save GLB",
    "description": "Writes a mesh as a .glb with its UVs and PBR textures embedded.",
    "python_module": "comfy_extras.nodes_load_3d",
    "category": "3d",
    "output_node": true
  },
  "GetMeshInfo": {
    "input": {
      "required": {
        "mesh": ["MESH", {}]
      }
    },
    "input_order": { "required": ["mesh"] },
    "output": ["STRING"],
    "output_is_list": [false],
    "output_name": ["info"],
    "name": "GetMeshInfo",
    "display_name": "Get Mesh Info",
    "description": "Reports a mesh's face, vertex and component counts as text.",
    "python_module": "comfy_extras.nodes_load_3d",
    "category": "3d",
    "output_node": true
  },
  "FailMe": {
    "input": {
      "required": {
        "images": ["IMAGE", {}],
        "filename_prefix": ["STRING", { "default": "ComfyUI" }]
      }
    },
    "input_order": { "required": ["images", "filename_prefix"] },
    "output": [],
    "output_is_list": [],
    "output_name": [],
    "name": "FailMe",
    "display_name": "Fail Me",
    "description": "Test-only class the mock server always rejects at submit.",
    "python_module": "tests",
    "category": "testing",
    "output_node": true
  }
}
